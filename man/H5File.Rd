\if{html}{\out{<hr>}}
\if{html}{\out{<a id="method-H5File-create_dataset"></a>}}
\if{latex}{\out{\hypertarget{method-H5File-create_dataset}{}}}
\subsection{\code{H5File$create_dataset()}}{
  This function is the main interface to create a new dataset. Its parameters allow for customization of the default behavior, i.e. in order to get a specific datatype, a certain chunk size or dataset dimensionality. Also note that this function implements the HDF5-API function H5Dcreate2 and H5Dcreate_anon (if name is NULL). Please see the documentation at \url{https://support.hdfgroup.org/documentation/hdf5/latest/group___h5_d.html} for regular groups and \url{https://support.hdfgroup.org/documentation/hdf5/latest/group___h5_d.html} for anonymous groups for details.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{H5File$create_dataset(
  name,
  robj = NULL,
  dtype = NULL,
  space = NULL,
  dims = NULL,
  chunk_dims = "auto",
  gzip_level = 4,
  link_create_pl = h5const$H5P_DEFAULT,
  dataset_create_pl = h5const$H5P_DEFAULT,
  dataset_access_pl = h5const$H5P_DEFAULT
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{name}}{The name of the new dataset. If missing, an anonymous dataset is created}
      \item{\code{robj}}{An R-object to take as a template for creating the dataset. Either \code{robj} or both \code{dtype} and \code{space} have to be provided}
      \item{\code{dtype}}{The datatype to use for the creation of the object. Can be null if \code{robj} is given.}
      \item{\code{space}}{The space to use for the object creation. Can be null if \code{robj} is given. Otherwise an object of type \code{H5S} which specifies the dimensions of the dataset.}
      \item{\code{dims}}{Dimension of the new dataset; used if \code{space} is \code{NULL}. overwrite the dimension guessed from \code{robj} if \code{robj} is given.}
      \item{\code{chunk_dims}}{Size of the chunk. Has to have the same length as the dataset dimension. If \code{"auto"} then the size of each chunk is estimated so that each chunk is roughly as large in bytes as the value in the \code{hdf5r.chunk_size} option. See also \code{\link{guess_chunks}} for a more detailed explanation. If set to \code{NULL}, then no chunking is used, unless explicitly set in \code{dataset_create_pl}.}
      \item{\code{gzip_level}}{Only if \code{chunk_dims} is not null. If given, then the \code{dataset_create_pl} is set to enable zipping at the level given here. If set to NULL, then gzip is not set (but could be set otherwise in \code{dataset_create_pl}}
      \item{\code{link_create_pl}}{Link creation property list. See \code{\link{H5P_LINK_CREATE}}}
      \item{\code{dataset_create_pl}}{Dataset creation property list. See \code{\link{H5P_DATASET_CREATE}}}
      \item{\code{dataset_access_pl}}{Dataset access property list. See \code{\link{H5P_DATASET_ACCESS}}}
    }
    \if{html}{\out{</div>}}
  }
}

