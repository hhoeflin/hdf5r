\subsection{\code{H5S$select_hyperslab()}}{
  This function implements the HDF5-API function H5Sselect_hyperslab. Please see the documentation at \url{https://support.hdfgroup.org/documentation/hdf5/latest/group___h5_s.html} for details.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{H5S$select_hyperslab(
  start,
  count,
  stride = NULL,
  block = NULL,
  op = h5const$H5S_SELECT_SET
)}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{start}}{The offset at which the hyperslab starts, one value per dimension.}
      \item{\code{count}}{The number of blocks to select, one value per dimension.}
      \item{\code{stride}}{The distance between successive blocks, one value per dimension.}
      \item{\code{block}}{The size of each block, one value per dimension.}
      \item{\code{op}}{The selection operator to apply; one of the \code{H5S_SELECT_*} values in \code{\link{h5const}}.}
    }
    \if{html}{\out{</div>}}
  }
}

