\subsection{\code{H5S$subset()}}{
  Subsetting the space. This is mainly intended as a helper function for the '[' function, but can also be used on its own.
  \subsection{Usage}{
    \if{html}{\out{<div class="r">}}
    \preformatted{H5S$subset(args, op = h5const$H5S_SELECT_SET, envir = parent.frame())}
    \if{html}{\out{</div>}}
  }
  \subsection{Arguments}{
    \if{html}{\out{<div class="arguments">}}
    \describe{
      \item{\code{args}}{The indices for each dimension to subset given as a list. This makes this easier to use as a programmatic API. For interactive use we recommend the use of the \code{[} operator.}
      \item{\code{op}}{The operator to use. Same as for the other HDF5 space selection functions. One of the elements shown in \code{h5const$H5S_seloper_t}}
      \item{\code{envir}}{The environment in which to evaluate \code{args}}
    }
    \if{html}{\out{</div>}}
  }
}

